# Copie para .env (cp .env.example .env) e ajuste. O docker compose lê este arquivo sozinho.

# Banco de dados (Postgres do Docker)
POSTGRES_USER=fila
POSTGRES_PASSWORD=fila
POSTGRES_DB=fila_facil

# Portas no seu computador
API_PORT=3000
SITE_PORT=8080

# Endereço da API como o NAVEGADOR enxerga (grava no build do site).
# Mesmo computador: http://localhost:3000 | Outro aparelho: http://IP-DO-COMPUTADOR:3000
VITE_API_URL=http://localhost:3000

# Quem pode chamar a API (CORS). "*" libera todos; ou liste: http://localhost:8080,https://meusite.com
CORS_ORIGIN=*
