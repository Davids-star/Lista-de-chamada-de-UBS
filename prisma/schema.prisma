generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  em_espera
  em_atendimento
  ausente
  finalizado
}

model Paciente {
  id            Int      @id @default(autoincrement())
  nome          String
  cpf           String   @unique
  telefone      String
  tipoAtendimento String
  motivo        String
  senha         Int
  status        Status   @default(em_espera)
  criadoEm      DateTime @default(now())
  atendidoEm    DateTime?

  @@index([status, criadoEm])
}